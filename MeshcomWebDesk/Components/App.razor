@using Microsoft.Extensions.Options
@using MeshcomWebDesk.Models
@using MeshcomWebDesk.Services
@inject IOptionsMonitor<MeshcomSettings> SettingsMonitor
<!DOCTYPE html>
<html lang="de" translate="no">

<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0f3460" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MeshCom" />
    <title>MeshCom WebDesk</title>
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="icons/icon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="favicon.png" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    @* Display mode (compact layout for tiny screens, e.g. 480x320 Raspberry Pi touch displays).
       Runs before first paint. ?display=compact|normal|auto only applies to this browser tab
       (sessionStorage, so a test URL never leaks into other windows or the installed app);
       the choice in Settings -> Appearance is kept permanently (localStorage).
       "auto" picks compact for very small viewports: up to 500px high in landscape (a phone held sideways is only
       about 375-430px high; with the normal layout the header, tabs, send bar and status bar left no room for the
       chat) and up to 340px wide in portrait. CSS keys off html[data-display="compact"]. *@
    <script>
        (function () {
            var KEY = 'meshcom.display';
            var mode = 'auto';
            try {
                var q = new URLSearchParams(location.search).get('display');
                if (q === 'compact' || q === 'normal' || q === 'auto') sessionStorage.setItem(KEY, q);
                mode = sessionStorage.getItem(KEY) || localStorage.getItem(KEY) || 'auto';
            } catch (e) { /* storage blocked: stay on auto */ }
            var mq = window.matchMedia('(max-height: 500px) and (orientation: landscape), (max-width: 340px) and (orientation: portrait)');
            function apply() {
                var compact = mode === 'compact' || (mode !== 'normal' && mq.matches);
                document.documentElement.setAttribute('data-display', compact ? 'compact' : 'normal');
            }
            apply();
            if (mq.addEventListener) mq.addEventListener('change', apply);
            // Used by Settings -> Appearance (auto | normal | compact), stored per browser
            window.meshcomDisplay = {
                get: function () { return mode; },
                set: function (m) {
                    if (m !== 'compact' && m !== 'normal') m = 'auto';
                    mode = m;
                    try { localStorage.setItem(KEY, m); sessionStorage.removeItem(KEY); } catch (e) { }
                    apply();
                }
            };
            // Blazor enhanced navigation re-syncs <html> attributes and drops ours: put it back.
            new MutationObserver(function () {
                var want = document.documentElement.getAttribute('data-display');
                if (!want) apply();
            }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-display'] });
        })();
    </script>
    @* Monitor pane size and visibility, from the browser storage, before first paint. Without this the chat
       page is built with default sizes and chat.js/Blazor restore the saved ones afterwards – the send bar and
       the monitor visibly jump on every page change. <html data-monitor="0|1"> and --monitor-h (px, if saved)
       are the single source for the CSS; chat.js keeps them in sync when the user resizes or toggles. *@
    <script>
        (function () {
            var root = document.documentElement;
            var h = 0, vis = null;
            try {
                h   = parseInt(localStorage.getItem('meshcom-monitor-height') || '0', 10) || 0;
                // v2: the old key was only ever set on phones, where it had no effect on a big screen; it must not hide
                // the monitor there now that the toggle works on every screen size. Default: visible.
                vis = localStorage.getItem('meshcom-monitor-visible-v2');
            } catch (e) { }
            // First visit on a compact (tiny) display starts with the monitor hidden, otherwise visible.
            var cur = vis === null ? (root.getAttribute('data-display') === 'compact' ? '0' : '1') : vis;
            var timer = null;
            function apply() {
                if (h > 0) {
                    if (root.getAttribute('data-mon-h') !== '1') root.setAttribute('data-mon-h', '1');
                    var px = h + 'px';
                    if (root.style.getPropertyValue('--monitor-h') !== px) root.style.setProperty('--monitor-h', px);
                }
                if (root.getAttribute('data-monitor') !== cur) root.setAttribute('data-monitor', cur);
            }
            apply();
            window.meshcomMonitor = {
                setHeight: function (px) { h = px > 0 ? px : 0; apply(); },
                setVisible: function (visible, animate) {
                    if (animate) {
                        root.classList.add('mon-animate');
                        clearTimeout(timer);
                        timer = setTimeout(function () { root.classList.remove('mon-animate'); }, 400);
                    }
                    cur = visible ? '1' : '0';
                    apply();
                }
            };
            // Blazor enhanced navigation re-syncs <html> attributes and drops ours: put them back.
            new MutationObserver(apply).observe(root, { attributes: true, attributeFilter: ['data-monitor', 'data-mon-h', 'style'] });
        })();
    </script>
    <link rel="stylesheet" href="lib/leaflet/leaflet.css" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MeshcomWebDesk.styles.css"]" />
    @* Active theme: overrides the dark token defaults from app.css (no FOUC) *@
    <style id="theme-vars">@((MarkupString)_themeCss)</style>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <div id="blazor-error-ui" data-nosnippet>
        Ein Fehler ist aufgetreten. &nbsp;<a href="." class="reload">Neu laden</a><span class="dismiss">🗙</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="lib/leaflet/leaflet.js"></script>
    <script src="lib/qrcode/qrcode.js"></script>
    <script src="@Assets["qr.js"]"></script>
    <script src="@Assets["map.js"]"></script>
    <script src="@Assets["chat.js"]"></script>
    <script src="@Assets["update.js"]"></script>
    <script>
        window.scrollToBottom = function (id) {
            var el = document.getElementById(id);
            if (el) el.scrollTop = el.scrollHeight;
        };

        // ── Notification sound via Web Audio API (no audio file required) ──────
        (function () {
            var _audioCtx = null;
            var _audioUnlocked = false;

            function getAudioContext() {
                if (!_audioCtx) {
                    _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                return _audioCtx;
            }

            // iOS requires AudioContext.resume() to be called synchronously inside
            // a user-gesture handler (touchstart fires before click on iOS).
            // We also create the context here so it is ready when the first beep arrives.
            function unlockAudio() {
                if (_audioUnlocked) return;
                try {
                    var ctx = getAudioContext();
                    if (ctx.state === 'suspended') {
                        ctx.resume().then(function () { _audioUnlocked = true; });
                    } else {
                        _audioUnlocked = true;
                    }
                } catch (e) { /* ignore */ }
            }

            document.addEventListener('touchstart', unlockAudio, { passive: true, once: true });
            document.addEventListener('click',      unlockAudio, { passive: true, once: true });

            function playBeep(ctx) {
                var now = ctx.currentTime;
                // Two-tone beep: 880 Hz then 660 Hz
                [0, 0.18].forEach(function (offset, i) {
                    var osc  = ctx.createOscillator();
                    var gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.type = 'sine';
                    osc.frequency.value = i === 0 ? 880 : 660;
                    gain.gain.setValueAtTime(0.0, now + offset);
                    gain.gain.linearRampToValueAtTime(0.25, now + offset + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.15);
                    osc.start(now + offset);
                    osc.stop(now + offset + 0.15);
                });
            }

            window.playNotificationBeep = function () {
                try {
                    var ctx = getAudioContext();
                    if (ctx.state === 'suspended') {
                        ctx.resume().then(function () { playBeep(ctx); });
                    } else {
                        playBeep(ctx);
                    }
                } catch (e) {
                    console.warn('Audio notification failed:', e);
                }
            };

            // CQ beep: Morse CQ CQ in CW style (700 Hz)
            // Timing: dit=1u dah=3u, inter-element=1u, inter-char=3u, inter-word=7u. Unit = 80 ms.
            // C = dah dit dah dit   (- . - .)
            // Q = dah dah dit dah   (- - . -)
            window.playCqBeep = function () {
                try {
                    var ctx = getAudioContext();
                    function doCq() {
                        var u   = 0.08;
                        var hz  = 700;
                        var vol = 0.30;
                        var t   = ctx.currentTime + 0.05;

                        // null  = inter-character pause (+2u, total 3u with the trailing 1u)
                        // false = inter-word pause     (+6u, total 7u with the trailing 1u)
                        // CQ CQ
                        var cq = [3,1,3,1, null, 3,3,1,3,  false,  3,1,3,1, null, 3,3,1,3];

                        cq.forEach(function (len) {
                            if (len === null)  { t += 2 * u; return; }  // inter-char
                            if (len === false)  { t += 6 * u; return; }  // inter-word
                            var osc  = ctx.createOscillator();
                            var gain = ctx.createGain();
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.type = 'sine';
                            osc.frequency.value = hz;
                            gain.gain.setValueAtTime(0.0, t);
                            gain.gain.linearRampToValueAtTime(vol, t + 0.005);
                            gain.gain.setValueAtTime(vol, t + len * u - 0.005);
                            gain.gain.linearRampToValueAtTime(0.0, t + len * u);
                            osc.start(t);
                            osc.stop(t + len * u + 0.01);
                            t += len * u + u; // tone + inter-element gap
                        });
                    }
                    if (ctx.state === 'suspended') { ctx.resume().then(doCq); } else { doCq(); }
                } catch (e) { console.warn('CQ beep failed:', e); }
            };

            // Three-tone ascending beep (660 → 880 → 1100 Hz) for watchlist alerts
            window.playWatchlistBeep = function () {
                try {
                    var ctx = getAudioContext();
                    function doPlay() {
                        var now = ctx.currentTime;
                        [0, 0.15, 0.30].forEach(function (offset, i) {
                            var osc  = ctx.createOscillator();
                            var gain = ctx.createGain();
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.type = 'sine';
                            osc.frequency.value = [660, 880, 1100][i];
                            gain.gain.setValueAtTime(0.0, now + offset);
                            gain.gain.linearRampToValueAtTime(0.3, now + offset + 0.02);
                            gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.12);
                            osc.start(now + offset);
                            osc.stop(now + offset + 0.12);
                        });
                    }
                    if (ctx.state === 'suspended') {
                        ctx.resume().then(doPlay);
                    } else {
                        doPlay();
                    }
                } catch (e) {
                    console.warn('Watchlist audio notification failed:', e);
                }
            };

            // Two "ding-dong" pairs (988 -> 1319 Hz, twice) when somebody mentions our callsign (at-sign + callsign)
            window.playMentionBeep = function () {
                try {
                    var ctx = getAudioContext();
                    function doPlay() {
                        var now = ctx.currentTime;
                        [0, 0.16, 0.45, 0.61].forEach(function (offset, i) {
                            var osc  = ctx.createOscillator();
                            var gain = ctx.createGain();
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.type = 'triangle';
                            osc.frequency.value = [988, 1319, 988, 1319][i];
                            gain.gain.setValueAtTime(0.0, now + offset);
                            gain.gain.linearRampToValueAtTime(0.32, now + offset + 0.02);
                            gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.15);
                            osc.start(now + offset);
                            osc.stop(now + offset + 0.15);
                        });
                    }
                    if (ctx.state === 'suspended') { ctx.resume().then(doPlay); } else { doPlay(); }
                } catch (e) {
                    console.warn('Mention audio notification failed:', e);
                }
            };
        })();

        // ── Text-to-Speech via Web Speech API ────────────────────────────────
        // iOS/iPadOS: TTS from background callbacks is blocked by Apple – skipped on iOS.
        // Desktop: cancel() + speak() as usual.
        window.speakText = function (text, lang) {
            // iOS/iPadOS: speechSynthesis from background callbacks is blocked by Apple.
            // Beep sounds (AudioContext) are used instead – skip TTS entirely on iOS.
            // Since iPadOS 13, Safari on iPad reports a desktop macOS user-agent
            // (no "iPad" substring) unless the user opted into the mobile site.
            var isIos = (/iPad|iPhone|iPod/.test(navigator.userAgent)
                || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1))
                && !window.MSStream;
            if (isIos) return;

            try {
                if (!window.speechSynthesis) return;
                var localeMap = { 'de': 'de-DE', 'en': 'en-US', 'it': 'it-IT', 'es': 'es-ES', 'fr': 'fr-FR' };
                var locale = localeMap[lang] || 'de-DE';

                function doSpeak() {
                    var utter = new SpeechSynthesisUtterance(text);
                    utter.lang   = locale;
                    utter.rate   = 0.95;
                    utter.pitch  = 1.0;
                    utter.volume = 1.0;
                    window.speechSynthesis.speak(utter);
                }

                window.speechSynthesis.cancel();
                doSpeak();
            } catch (e) {
                console.warn('speakText failed:', e);
            }
        };

        // Register service worker for PWA install prompt
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js');
        }

        // ── Theming helpers (Settings → Erscheinungsbild) ──────────────────
        // Live preview: set CSS custom properties without a save/reload.
        window.applyThemeVars = function (vars) {
            var root = document.documentElement;
            for (var key in vars) {
                if (Object.prototype.hasOwnProperty.call(vars, key)) {
                    root.style.setProperty('--' + key, vars[key]);
                }
            }
        };

        // Remove all inline preview overrides (falls back to saved theme).
        window.clearThemeVars = function () {
            document.documentElement.removeAttribute('style');
        };

        // Download a text file (theme export)
        window.downloadTextFile = function (filename, text) {
            var blob = new Blob([text], { type: 'application/json;charset=utf-8' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
    </script>
</body>

</html>

@code {
    private string _themeCss = string.Empty;

    protected override void OnInitialized()
        => _themeCss = ThemeCatalog.BuildRootCss(SettingsMonitor.CurrentValue.Appearance);
}
