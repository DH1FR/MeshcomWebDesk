@using Microsoft.Extensions.Options
@using MeshcomWebDesk.Models
@using MeshcomWebDesk.Services
@inject IOptionsMonitor<MeshcomSettings> SettingsMonitor
@inject MeshcomUdpService UdpService
@inject SettingsService SettingsSvc
@inject ChatService ChatService

<div class="send-bar-wrap">
    @if (_flyoutOpen && _quickTexts.Count > 0)
    {
        <div class="quicktext-flyout" id="qt-flyout">
            @for (var i = 0; i < _quickTexts.Count; i++)
            {
                var idx = i;
                var qt = _quickTexts[i];
                <button class="quicktext-btn" draggable="true" data-qt-idx="@idx"
                        @onclick="() => LoadQuickText(qt.Text)" title="@qt.Text">
                    @qt.Label
                </button>
            }
            <button class="quicktext-close" @onclick="() => _flyoutOpen = false" title="@Loc.T("Schließen", "Close")">✕</button>
        </div>
    }
    @if (_varFlyoutOpen)
    {
        <div class="var-flyout">
            <div class="var-head">
                <span>@Loc.T("Variable einfügen", "Insert variable")</span>
                <button class="quicktext-close" @onclick="CloseVarFlyout" title="@Loc.T("Schließen", "Close")">✕</button>
            </div>
            <div class="var-list">
                @foreach (var v in _varItems)
                {
                    var item = v;
                    <button class="var-row" disabled="@(item.Value.Length == 0 || item.Value == VarPending)"
                            @onclick="() => InsertVariableAsync(item.Value)"
                            title="@item.Token">
                        <span class="var-label">@Loc.T(item.De, item.En)</span>
                        <span class="var-value">@(item.Value.Length == 0 ? "–" : item.Value)</span>
                    </button>
                }
            </div>
        </div>
    }
    <div class="send-bar">
        @if (_quickTexts.Count > 0)
        {
            <button class="btn-quicktext @(_flyoutOpen ? "btn-quicktext-active" : "")"
                    @onclick="ToggleFlyout"
                    title="@Loc.T("Schnelltexte", "Quick Texts")">⚡</button>
        }
        <button class="btn-quicktext @(_varFlyoutOpen ? "btn-quicktext-active" : "")"
                @onclick="ToggleVarFlyout"
                title="@Loc.T("Variable einfügen", "Insert variable")">@("{}")</button>
        <textarea id="send-bar-input"
                  placeholder="@Loc.T("Nachricht eingeben...", "Enter message...")"
                  maxlength="149"
                  spellcheck="true"
                  autocomplete="on"
                  lang="de"
                  rows="1"></textarea>
        <span class="char-counter">0/149</span>
        <button class="btn-send @(ChatService.TxCooldownRemaining > 0 ? "btn-send-cooldown" : "")"
                disabled="@(ChatService.TxCooldownRemaining > 0 ? "disabled" : null)"
                @onclick="SendAsync">
            @if (ChatService.TxCooldownRemaining > 0)
            {
                <span>⏳ @ChatService.TxCooldownRemaining s</span>
            }
            else
            {
                @Loc.T("Senden", "Send")
            }
        </button>
    </div>
</div>

@implements IDisposable
@inject IJSRuntime JS

@code {
    [Parameter, EditorRequired] public EventCallback<string> OnSend { get; set; }
    /// <summary>Callsign of the current chat partner (or group). Used for {callsign}, {rssi}, … variable expansion.</summary>
    [Parameter] public string? Callsign { get; set; }

    [Inject] private LanguageService Loc { get; set; } = default!;

    private string _text = string.Empty;
    private bool   _flyoutOpen;
    private List<QuickTextEntry> _quickTexts = [];
    private const int MaxLength = 149;
    private DotNetObjectReference<SendBar>? _dotNetRef;
    private IDisposable? _settingsListener;
    private CancellationTokenSource? _cooldownCts;

    protected override void OnInitialized()
    {
        Loc.OnChange += OnLocChange;
        LoadQuickTextsFromSettings();
        _settingsListener = SettingsMonitor.OnChange(changed =>
        {
            LoadQuickTextsFromSettings();
            InvokeAsync(ForceRerender);
            _ = InvokeAsync(PushEmoticonSettingAsync);
        });
    }

    /// <summary>Tells chat.js whether (and with which table) to convert emoticons while typing; null = off.</summary>
    private async Task PushEmoticonSettingAsync()
    {
        try
        {
            object? map = SettingsMonitor.CurrentValue.EmoticonsToEmoji ? EmoticonConverter.Map : null;
            await JS.InvokeVoidAsync("meshcomChat.setEmoticons", map);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
            // circuit not ready / already gone – the next settings change or page load pushes it again
        }
    }

    private bool _rendered;

    protected override bool ShouldRender()
    {
        if (ChatService.TxCooldownRemaining > 0) { _rendered = false; return true; }
        if (!_rendered) { _rendered = true; return true; }
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("meshcomChat.initSendBarCounter", "send-bar-input", _dotNetRef);
            await PushEmoticonSettingAsync();
        }

        if (_flyoutOpen && _quickTexts.Count > 0)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("meshcomChat.initQuickTextDrag", _dotNetRef);
        }
    }

    private void OnLocChange() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        // Do NOT cancel _cooldownCts here – the timer must finish its countdown
        // even if the component is disposed (e.g. on navigation away).
        Loc.OnChange -= OnLocChange;
        _settingsListener?.Dispose();
        _dotNetRef?.Dispose();
    }

    private void LoadQuickTextsFromSettings()
    {
        _quickTexts = SettingsMonitor.CurrentValue.QuickTexts
            .Where(q => !string.IsNullOrWhiteSpace(q.Label) && !string.IsNullOrWhiteSpace(q.Text))
            .ToList();
    }

    [JSInvokable]
    public async Task MoveQuickText(int fromIdx, int toIdx)
    {
        if (fromIdx < 0 || fromIdx >= _quickTexts.Count || toIdx < 0 || toIdx >= _quickTexts.Count || fromIdx == toIdx)
            return;

        // Reorder the in-memory list
        var item = _quickTexts[fromIdx];
        _quickTexts.RemoveAt(fromIdx);
        _quickTexts.Insert(toIdx, item);

        // Persist: replace the valid entries in the settings list with the new order
        var fullList   = SettingsMonitor.CurrentValue.QuickTexts;
        var validIdxs  = fullList
            .Select((q, i) => new { q, i })
            .Where(x => !string.IsNullOrWhiteSpace(x.q.Label) && !string.IsNullOrWhiteSpace(x.q.Text))
            .Select(x => x.i)
            .ToList();

        if (fromIdx < validIdxs.Count && toIdx < validIdxs.Count)
        {
            // Build reordered list of valid entries
            var validEntries = validIdxs.Select(i => fullList[i]).ToList();
            var moved = validEntries[fromIdx];
            validEntries.RemoveAt(fromIdx);
            validEntries.Insert(toIdx, moved);

            // Write back into the full list at the same slot positions
            for (var i = 0; i < validIdxs.Count; i++)
                fullList[validIdxs[i]] = validEntries[i];
        }

        // Save to appsettings.override.json
        _ = SettingsSvc.SaveMeshcomSettingsAsync(SettingsMonitor.CurrentValue);

        _rendered = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ForceRerender() { _rendered = false; StateHasChanged(); }

    private void ToggleFlyout() { _flyoutOpen = !_flyoutOpen; if (_flyoutOpen) _varFlyoutOpen = false; ForceRerender(); }

    // ── Variable picker ({}): inserts the CURRENT VALUE of a variable at the cursor ──
    private sealed record VarItem(string Token, string De, string En, string Value = "");

    // The English texts match Settings → auto-reply variables, so the es/fr/it translations already exist.
    private static readonly VarItem[] VarDefs =
    [
        new("{mycall}",            "Eigenes Rufzeichen",                  "Own callsign"),
        new("{callsign}",          "Rufzeichen Gesprächspartner",         "Chat partner callsign"),
        new("{dest-name}",         "Vorname (QRZ)",                       "First name (QRZ)"),
        new("{dest-loc}",          "Standort (QRZ)",                      "Location (QRZ)"),
        new("{mylocator}",         "Eigener QTH-Locator",                 "Own QTH Locator"),
        new("{locator}",           "QTH-Locator (Gesprächspartner)",      "QTH Locator (partner)"),
        new("{rssi}",              "RSSI (letzter Empfang)",              "RSSI (last RX)"),
        new("{snr}",               "SNR (letzter Empfang)",               "SNR (last RX)"),
        new("{hw}",                "Hardware-Typ",                        "Hardware type"),
        new("{route}",             "Relay-Pfad",                          "Relay path"),
        new("{hops}",              "Anzahl Relay-Hops",                   "Relay hop count"),
        new("{date}",              "Aktuelles Datum",                     "Current date"),
        new("{time}",              "Aktuelle Uhrzeit",                    "Current time"),
        new("{last-qso}",          "Letztes QSO mit diesem Rufzeichen",   "Last QSO with this callsign"),
        new("{telemetry}",         "Telemetrie-String (aus JSON-Datei)",  "Telemetry string (from JSON file)"),
        new("{node-firmware}",     "Node-Firmware",                       "Node firmware"),
        new("{node-hw}",           "Node-Hardware",                       "Node hardware"),
        new("{version}",           "App-Version",                         "App version"),
        new("{my-tx-power}",       "Sendeleistung der eigenen Station",   "Own station TX power"),
        new("{my-eirp}",           "Effektive Strahlungsleistung (EIRP)", "Effective isotropic radiated power (EIRP)"),
        new("{my-antenna}",        "Antennengewinn der eigenen Station",  "Own station antenna gain"),
        new("{my-antenna-type}",   "Antennentyp der eigenen Station",     "Own station antenna type"),
        new("{my-antenna-height}", "Antennenhöhe der eigenen Station",    "Own station antenna height"),
        new("{my-freq}",           "Sendefrequenz der eigenen Station",   "Own station frequency"),
    ];

    private bool _varFlyoutOpen;
    private List<VarItem> _varItems = [];

    private void CloseVarFlyout() { _varFlyoutOpen = false; ForceRerender(); }

    // {last-qso} (database query) and {telemetry} (reads files) are slow – everything else resolves instantly
    private static bool IsSlowVar(string token) => token is "{last-qso}" or "{telemetry}";
    private const string VarPending = "…";

    private async Task ToggleVarFlyout()
    {
        if (_varFlyoutOpen) { CloseVarFlyout(); return; }
        _flyoutOpen = false;

        // open at once with the cheap values; the slow ones follow below
        var items = new List<VarItem>(VarDefs.Length);
        foreach (var d in VarDefs)
        {
            string value;
            if (IsSlowVar(d.Token)) value = VarPending;
            else
            {
                try { value = UdpService.ExpandVariables(d.Token, Callsign).Trim(); }
                catch { value = ""; }
            }
            // a token that stays unresolved is not worth offering
            items.Add(d with { Value = value.Equals(d.Token, StringComparison.OrdinalIgnoreCase) ? "" : value });
        }
        _varItems = items;
        _varFlyoutOpen = true;
        ForceRerender();

        var generation = ++_varGeneration;
        foreach (var d in VarDefs.Where(v => IsSlowVar(v.Token)))
        {
            string value;
            try { value = (await UdpService.ExpandVariablesAsync(d.Token, Callsign)).Trim(); }
            catch { value = ""; }
            if (value.Equals(d.Token, StringComparison.OrdinalIgnoreCase)) value = "";
            if (!_varFlyoutOpen || generation != _varGeneration) return;   // closed or reopened meanwhile
            var i = _varItems.FindIndex(x => x.Token == d.Token);
            if (i >= 0) _varItems[i] = _varItems[i] with { Value = value };
            await InvokeAsync(ForceRerender);
        }
    }

    private int _varGeneration;

    private async Task InsertVariableAsync(string value)
    {
        _varFlyoutOpen = false;
        _rendered = false;
        await JS.InvokeVoidAsync("meshcomChat.insertAtCursor", "send-bar-input", value, MaxLength);
    }

    private async Task LoadQuickText(string text)
    {
        var expanded = await UdpService.ExpandVariablesAsync(text, Callsign);
        _flyoutOpen = false;
        _rendered   = false;
        await JS.InvokeVoidAsync("meshcomChat.insertQuickTextAtCursor", "send-bar-input", expanded, MaxLength);
    }

    [JSInvokable]
    public async Task JsSendAsync()
    {
        if (ChatService.TxCooldownRemaining > 0) return;
        _text = await JS.InvokeAsync<string>("meshcomChat.getSendBarValue", "send-bar-input");
        // The last word has no trailing space yet, so the live conversion in chat.js did not see it
        if (SettingsMonitor.CurrentValue.EmoticonsToEmoji) _text = EmoticonConverter.Convert(_text);
        if (string.IsNullOrWhiteSpace(_text) || _text.Length > MaxLength) return;
        var expanded = await UdpService.ExpandVariablesAsync(_text, Callsign);
        var text = expanded.Length > MaxLength ? expanded[..MaxLength] : expanded;
        if (MessageValidator.JsonEncodedLength(text) > MessageValidator.MaxJsonMsgBytes) return;
        _text = string.Empty;
        await JS.InvokeVoidAsync("meshcomChat.setSendBarValue", "send-bar-input", string.Empty);
        await OnSend.InvokeAsync(text);
        _ = StartCooldownTimerAsync();
    }

    private async Task StartCooldownTimerAsync()
    {
        _cooldownCts?.Cancel();
        _cooldownCts = new CancellationTokenSource();
        var token = _cooldownCts.Token;
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (!token.IsCancellationRequested && ChatService.TxCooldownRemaining > 0)
            {
                await timer.WaitForNextTickAsync(token);
                await InvokeAsync(StateHasChanged);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    [JSInvokable]
    public async Task<string> JsExpandVariables(string text)
    {
        var expanded = await UdpService.ExpandVariablesAsync(text, Callsign);
        return expanded.Length > MaxLength ? expanded[..MaxLength] : expanded;
    }

    private async Task SendAsync()
    {
        await JsSendAsync();
    }

    /// <summary>Fügt @CALLSIGN an der aktuellen Cursorposition im Eingabefeld ein.</summary>
    public async Task InsertMentionAsync(string callsign)
    {
        var mention = "@" + callsign;
        await JS.InvokeVoidAsync("meshcomChat.insertAtCursor", "send-bar-input", mention);
    }
}
