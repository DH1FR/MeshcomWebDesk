@rendermode InteractiveServer
@inject MeshcomWebDesk.Services.UpdateCheckService UpdateCheck
@inject MeshcomWebDesk.Services.LanguageService Loc
@inject MeshcomWebDesk.Services.Update.DockerUpdateService Docker
@implements IDisposable

@if (!UpdateCheck.Dismissed && UpdateCheck.LatestVersion is not null)
{
    <div class="update-banner">
        <span>🚀 @Loc.TF("Neue Version verfügbar: {0}", "New version available: {0}", UpdateCheck.LatestVersion)</span>
        <a href="@UpdateCheck.ReleasePageUrl" target="_blank" rel="noopener" class="update-banner-link">
            @Loc.T("Zum Release", "View Release") ↗
        </a>
        <a href="/update" class="update-banner-link">@Loc.T("Jetzt aktualisieren", "Update now") →</a>
        <button class="update-banner-dismiss" @onclick="Dismiss" @onclick:stopPropagation="true"
                title="@Loc.T("Schließen", "Dismiss")">✕</button>
    </div>
}

@* Only once the image is published; while the CI still builds it, the update page explains the wait. *@
@if (!UpdateCheck.Dismissed && _dockerDev is { Available: true, ImageBuilding: false })
{
    <div class="update-banner">
        <span>🚀 @Loc.TF("Neuer Dev-Build verfügbar: {0}", "New dev build available: {0}", _dockerDev.Latest)</span>
        <a href="/update" class="update-banner-link">@Loc.T("Jetzt aktualisieren", "Update now") →</a>
        <button class="update-banner-dismiss" @onclick="Dismiss" @onclick:stopPropagation="true"
                title="@Loc.T("Schließen", "Dismiss")">✕</button>
    </div>
}

@code {
    private MeshcomWebDesk.Services.Update.DockerUpdateInfo? _dockerDev;

    protected override async Task OnInitializedAsync()
    {
        UpdateCheck.OnUpdateAvailable += OnUpdateFound;

        // Docker, dev channel: the release check does not know about new dev builds – ask the dev branch.
        if (MeshcomWebDesk.Services.Update.DockerUpdateService.InContainer
            && MeshcomWebDesk.Services.Update.DockerUpdateService.Channel == "dev")
        {
            try { _dockerDev = await Docker.GetInfoAsync(); }
            catch (Exception) { /* offline: no banner */ }
        }
    }

    private void OnUpdateFound() => InvokeAsync(StateHasChanged);

    private void Dismiss()
    {
        UpdateCheck.Dismiss();
        StateHasChanged();
    }

    public void Dispose() => UpdateCheck.OnUpdateAvailable -= OnUpdateFound;
}
