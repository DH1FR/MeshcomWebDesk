@inherits LayoutComponentBase
@inject MeshcomWebDesk.Services.LanguageService Loc
@inject Microsoft.Extensions.Options.IOptionsMonitor<MeshcomWebDesk.Models.MeshcomSettings> SettingsMon
@inject MeshcomWebDesk.Services.AppLicenseService LicenseService
@inject MeshcomWebDesk.Services.NodeManager NodeManager
@implements IDisposable

<div class="app-layout">
    <header class="app-header">
        <div class="app-header-brand">
            <span>📡</span>
            <span class="app-title @(LicenseService.IsLicensed ? "app-title--licensed" : "")">MeshCom WebDesk <span class="app-version">v@_version</span>
                @if (LicenseService.IsLicensed)
                {
                    <span class="app-license-badge app-license-badge--licensed"><span class="app-license-text">✅ @Loc.T("Lizenziert für", "Licensed for") <span class="app-license-call">@LicenseService.LicensedCallsign</span></span></span>
                }
                else
                {
                    <a class="app-license-badge app-license-badge--unlicensed" href="/about" title="@Loc.T("Lizenz erhalten: PayPal-Spende → Rufzeichen-Lizenzschlüssel", "Get a license: PayPal donation → callsign license key")">💛 @Loc.T("Kostenlos – Per PayPal lizenzieren?", "Free – License via PayPal?")</a>
                }
            </span>
        </div>
        @if (NodeManager.HasMultipleNodes)
        {
            @* Only shown in compact display mode (the node button bar is hidden there) *@
            <select class="app-node-select" @onchange="OnNodeSelected" title="@Loc.T("Node wechseln", "Switch node")">
                @foreach (var node in NodeManager.Nodes)
                {
                    <option value="@node.Id" selected="@(NodeManager.SelectedNode?.Id == node.Id)">@node.Name</option>
                }
            </select>
        }
        <nav class="app-nav">
            <NavLink class="app-nav-link" href="/" Match="NavLinkMatch.All">💬 <span class="nav-label">@Loc.T("Chat", "Chat")</span></NavLink>
            <NavLink class="app-nav-link" href="/mh">📻 <span class="nav-label">MH</span></NavLink>
            <NavLink class="app-nav-link" href="/map">🗺️ <span class="nav-label">@Loc.T("Karte", "Map")</span></NavLink>
            @if (SettingsMon.CurrentValue.WebLinks.Any(w => w.Enabled))
            {
                <NavLink class="app-nav-link" href="/web">🌐 <span class="nav-label">Web</span></NavLink>
            }
            @if (SettingsMon.CurrentValue.TelnetEnabled)
            {
                <NavLink class="app-nav-link" href="/telnet">🖥️ <span class="nav-label">NET Console</span></NavLink>
            }
            <NavLink class="app-nav-link" href="/settings">⚙️ <span class="nav-label">@Loc.T("Einstellungen", "Settings")</span></NavLink>
            <NavLink class="app-nav-link" href="/clear">🗑️ <span class="nav-label">@Loc.T("Löschen", "Clear")</span></NavLink>
            <NavLink class="app-nav-link" href="/about">ℹ️ <span class="nav-label">@Loc.T("Über", "About")</span></NavLink>
            <a class="app-nav-link" href="@($"https://github.com/DH1FR/MeshcomWebDesk/blob/master/docs/node-connection-{Loc.DocsLanguage}.md")" target="_blank" rel="noopener">
                ❓ <span class="nav-label">@Loc.T("Hilfe", "Help")</span>
            </a>
        </nav>
    </header>

    <UpdateBanner />

    <div class="app-body">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">@Loc.T("Neu laden", "Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _version =
        System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? string.Empty;

    private void OnLocChange() => _ = InvokeAsync(StateHasChanged);
    private void OnLicenseChange() => _ = InvokeAsync(StateHasChanged);
    private void OnNodeChange() => _ = InvokeAsync(StateHasChanged);

    private void OnNodeSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) NodeManager.SelectNode(id);
    }

    protected override void OnInitialized()
    {
        Loc.OnChange     += OnLocChange;
        LicenseService.OnLicenseChanged += OnLicenseChange;
        NodeManager.OnSelectedNodeChanged += OnNodeChange;
        SettingsMon.OnChange((settings, name) => InvokeAsync(StateHasChanged));
    }

    public void Dispose()
    {
        Loc.OnChange -= OnLocChange;
        LicenseService.OnLicenseChanged -= OnLicenseChange;
        NodeManager.OnSelectedNodeChanged -= OnNodeChange;
    }
}
