# Copy to ".env" next to docker-compose.image.yml and adjust. ".env" is read by "docker compose" automatically.

# Secret shared by WebDesk and Watchtower (WebDesk's "Update now" button uses it). Create one with:
#   openssl rand -hex 16
WATCHTOWER_TOKEN=change-me

# Update channel (= image tag):
#   latest  the newest release (recommended)
#   dev     every push to the dev branch (for testers)
WEBDESK_CHANNEL=latest

# Host port of the Watchtower API (only reachable from this machine). Change it if 8080 is already used.
#WATCHTOWER_PORT=8080
